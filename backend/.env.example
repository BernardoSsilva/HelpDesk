# Copie para .env (cp .env.example .env) para rodar a API localmente com `npm run dev`.

PORT=8080
DATABASE_URL="postgresql://ticket_user:ticket_password@localhost:5432/ticket_management?schema=public"

# Gere um valor próprio com:  openssl rand -hex 32
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Origens permitidas no CORS, separadas por vírgula. Vazio libera qualquer origem.
# FRONTEND_URL="http://localhost:5173"

# Número de proxies na frente da API (ex.: 1 atrás do nginx). Necessário para o limite de tentativas de login enxergar o IP real.
# TRUST_PROXY=1

# Tentativas de login malsucedidas por IP em cada janela (padrão: 10 a cada 15 minutos).
# Em escritórios com muitas pessoas atrás do mesmo IP, aumente o limite.
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Administrador criado por `npm run seed`
ADMIN_EMAIL="admin@empresa.com"
ADMIN_NAME="Administrador"
ADMIN_PASSWORD="admin123"

# Banco DESCARTÁVEL para `npm run test:integration` (o nome precisa conter "test"; as tabelas são apagadas!)
# TEST_DATABASE_URL="postgresql://ticket_user:ticket_password@localhost:5432/helpdesk_test?schema=public"
