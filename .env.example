# Copie para .env (cp .env.example .env) e ajuste antes de subir com `docker compose up --build`.

# Banco de dados
POSTGRES_DB=ticket_management
POSTGRES_USER=ticket_user
POSTGRES_PASSWORD=ticket_password
# POSTGRES_PORT=5432

# Portas publicadas na sua máquina
BACKEND_PORT=8080
FRONTEND_PORT=5173

# OBRIGATÓRIO. Segredo que assina os tokens de login: quem o conhece forja tokens de administrador.
# Gere um valor próprio com:  openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Tentativas de login malsucedidas por IP em cada janela (padrão: 10 a cada 15 minutos).
# Em escritórios com muitas pessoas atrás do mesmo IP, aumente o limite.
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Administrador criado na primeira subida (troque a senha!)
ADMIN_EMAIL=admin@empresa.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=admin123
